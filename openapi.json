{
  "openapi": "3.1.0",
  "info": {
    "title": "Banwords catalog API",
    "version": "2.0.0",
    "description": "Один функциональный каталог из Git-файла data/catalog.json. Данные /catalog и /catalog/hash доступны только через внешний service-токен Authorization: Bearer bw_…. Caddy/auth проверяет токен и актуальные права, затем выдаёт Ed25519 JWT с credential=service-token, iss=danysik-auth, aud=banwords и banwords:dictionaries:read. Cookie-сессия, включая superadmin, не открывает данные. OpenAPI JSON допускает также сессию с правом чтения. Текст сообщений не передаётся. История изменений хранится в Git; lookup словарей и runtime-архив отсутствуют."
  },
  "servers": [
    {
      "url": "https://danysik.ru"
    }
  ],
  "security": [
    {
      "serviceToken": []
    }
  ],
  "paths": {
    "/api/banwords/catalog": {
      "get": {
        "operationId": "getCatalog",
        "summary": "Полный функциональный каталог",
        "description": "Слова, варианты, категории и явные matchMode/replaceMode берутся из одного data/catalog.json. JSON приводится json.Marshal к стабильному порядку ключей; отступы и порядок ключей исходного файла не влияют на hash. ETag — SHA-256 тех же байтов, которые возвращаются в теле. Любое поле, порядок правил и вариантов входят в hash. Формат saypatch-rules/version=1 сохранён. Ответ всегда GET 200, условный GET/304 не используется.",
        "responses": {
          "200": {
            "description": "Каталог и strong ETag полного тела ответа.",
            "headers": {
              "ETag": {
                "description": "SHA-256 точных байтов тела, 64 lowercase hex в двойных кавычках.",
                "schema": {
                  "type": "string",
                  "pattern": "^\"[0-9a-f]{64}\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/banwords/catalog/hash": {
      "get": {
        "operationId": "getCatalogHash",
        "summary": "Актуальный SHA-256 всего каталога",
        "description": "Возвращает {hash}. Хэш совпадает с SHA-256 тела GET /catalog и значением его ETag без кавычек. Учитываются все поля каталога, включая режимы и варианты замен. Для данных обязателен service-токен; cookie-сессия не подходит.",
        "responses": {
          "200": {
            "description": "Свежесть полного функционального каталога.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogHash"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/banwords/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "Спецификация OpenAPI 3.1",
        "description": "Метаданные доступны по service-токену или cookie-сессии с правом чтения.",
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "security": [
          {
            "serviceToken": []
          },
          {
            "cookieSession": []
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthcheck",
        "summary": "Внутренняя готовность, наружу не проксируется",
        "security": [],
        "responses": {
          "204": {
            "description": "Единственный каталог валидирован при старте."
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "bw_<opaque random secret>",
        "description": "Внешний service-токен auth. Проверяется Caddy/auth; backend принимает только подписанный внутренний JWT с credential=service-token. Единственный способ чтения каталога и hash."
      },
      "cookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid",
        "description": "Вход через Twitch; разрешён только для OpenAPI JSON /openapi.json. Не открывает каталог или hash даже суперадминистратору."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "CatalogHash": {
        "type": "object",
        "required": [
          "hash"
        ],
        "additionalProperties": false,
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 полного тела GET /catalog без кавычек ETag."
          }
        }
      },
      "Catalog": {
        "type": "object",
        "required": [
          "format",
          "version",
          "variants",
          "rules"
        ],
        "additionalProperties": false,
        "properties": {
          "format": {
            "const": "saypatch-rules"
          },
          "version": {
            "const": 1
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2500,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "word",
                "category",
                "variantIds",
                "matchMode",
                "replaceMode"
              ],
              "additionalProperties": false,
              "properties": {
                "word": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "category": {
                  "enum": [
                    "safe",
                    "banword"
                  ]
                },
                "variantIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 50,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2499
                  }
                },
                "matchMode": {
                  "enum": [
                    "word",
                    "substring"
                  ],
                  "description": "word — целое слово; substring — поиск внутри слова"
                },
                "replaceMode": {
                  "enum": [
                    "word",
                    "match"
                  ],
                  "description": "word — заменить содержащее слово целиком; match — заменить только совпавший фрагмент"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Неизвестный путь, неверный JWT, недостаточные права либо попытка чтения данных через cookie-сессию (включая superadmin).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "Разрешён только GET (Allow: GET)",
        "headers": {
          "Allow": {
            "schema": {
              "const": "GET"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Лимит 60 запросов/мин на владельца токена, включая документацию; максимум 10000 активных владельцев",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Внутренняя ошибка без секретов и подробностей",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Временная недоступность JWKS auth. Истёкшие ключи из кеша не используются",
        "headers": {
          "Retry-After": {
            "schema": {
              "const": "5"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
